[Unit]
Description=Check chassis power-good for VPD

# Must complete before wait-vpd-parsers starts so the PowerState property
# exists on D-Bus before it is read.
Before=wait-vpd-parsers.service

# ibm-power-highend-platform-apps writes /run/openbmc/bmc_position which is
# read to select the correct GPIO line.  Without this ordering the position
# file may not yet exist and BMC with position 1 would read the wrong GPIO.
After=ibm-power-highend-platform-apps.service

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/bin/pgood-chassis-check
ExecStartPost=/bin/sh -c \
    "POWER_STATE=$$(busctl get-property \
        xyz.openbmc_project.Inventory.Manager \
        /xyz/openbmc_project/inventory/system \
        xyz.openbmc_project.State.Decorator.PowerState \
        PowerState 2>/dev/null | awk '{print $$2}' | tr -d '\"'); \
    if [ \"$$POWER_STATE\" = \"xyz.openbmc_project.State.Decorator.PowerState.State.Off\" ]; then \
        echo \"set-spi-mux: chassis PowerState is Off, running SPI mux logic.\"; \
        systemctl start set-spi-mux.service; \
    else \
        echo \"set-spi-mux: chassis PowerState is '$$POWER_STATE', skip setting SPI mux.\"; \
    fi"

[Install]
WantedBy=obmc-bmc-active.target
