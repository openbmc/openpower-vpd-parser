        "id": 1002186
      },
      "writtenOn": "2026-08-25T08:28:31Z",
      "side": 1,
      "message": "I agree LOC will be more, but its better to go with a generic approach rather than hard-coded approach as that will be future proof and reduce refactoring effort.",
      "parentUuid": "5d23a061_dcff6967",
      "revId": "832f1ae88f52a8d1d814096cdb59294fbca5613b",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
