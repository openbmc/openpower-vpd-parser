    {
      "unresolved": true,
      "key": {
        "uuid": "0bf9ab55_efc08799",
        "filename": "vpd-manager/include/utility/vpd_specific_utility.hpp",
        "patchSetId": 13
      },
      "lineNbr": 1521,
