      "side": 1,
      "message": "Can we use `std::format()` to construct the string? It\u0027s more efficient compared to the current implementation.",
      "revId": "232f6539393cee755b4c651d1207a9c335847af4",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
    {
