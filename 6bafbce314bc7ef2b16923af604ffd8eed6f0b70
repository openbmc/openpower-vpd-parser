      "writtenOn": "2026-07-27T14:11:56Z",
      "side": 1,
      "message": "`std::find_if()` would reduce the lines of change and make the purpose of this block more apparent.",
      "parentUuid": "820fd89d_161b3a59",
      "revId": "6bafbce314bc7ef2b16923af604ffd8eed6f0b70",
